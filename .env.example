# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/nibappointment
NEXTAUTH_URL=https://appointments.example.com
NEXTAUTH_TRUST_HOST=true
AUTH_SECRET=
# Public origin of this app. Used for the YagoutPay return URLs, so it must be
# the exact https origin registered with Yagout (no trailing slash).
NEXT_PUBLIC_BASE_URL=https://appointments.example.com

# ---------------------------------------------------------------------------
# NIB Super App (mini-app) payments — unchanged
# ---------------------------------------------------------------------------
NIB_PAYMENT_URL=
NIB_PAYMENT_KEY=
COMPANY_NAME=
CALLBACK_URL=
VALIDATE_TOKEN_URL=
NEXT_PUBLIC_VALIDATE_TOKEN_URL=

# ---------------------------------------------------------------------------
# YagoutPay (web payments)
#
# Only values shared by every hospital live here. Each hospital's merchant ID
# (me_id) and encryption key are entered by that hospital's admin in
# Settings -> YagoutPay. There is no platform-wide merchant account.
# ---------------------------------------------------------------------------
# Aggregator ID issued to NibTena by Yagout (defaults to "yagout").
YAGOUTPAY_AGGREGATOR_ID=yagout
# Default hosted-checkout URL. UAT:
#   https://uatcheckout.yagoutpay.com/ms-transaction-core-1-0/paymentRedirection/checksumGatewayPage
# Use the production URL Yagout gives you in production.
YAGOUTPAY_POST_URL=https://uatcheckout.yagoutpay.com/ms-transaction-core-1-0/paymentRedirection/checksumGatewayPage
# Extra hostnames (comma-separated) a hospital's Post URL override may use.
# The host of YAGOUTPAY_POST_URL is always allowed. These hosts are also added
# to the CSP form-action directive.
YAGOUTPAY_ALLOWED_HOSTS=uatcheckout.yagoutpay.com
# Minutes a web booking holds its slot while the patient pays (default 20).
YAGOUT_PAYMENT_HOLD_MINUTES=20
# Yagout requires a customer email; used when the patient has none.
YAGOUT_FALLBACK_EMAIL=payments@example.com
# Master key that encrypts each hospital's Yagout key at rest (32 bytes, base64).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every saved Yagout key unreadable; hospitals must re-enter them.
HOSPITAL_SECRET_KEY=

# Shared secret for POST/GET /api/cron/expire-payment-holds (header x-cron-secret).
CRON_SECRET=

# ---------------------------------------------------------------------------
# OTP SMS
# SMS_PROVIDER=http  -> POST JSON {to, message, sender} to SMS_API_URL with
#                       "Authorization: Bearer SMS_API_KEY".
# SMS_PROVIDER=console (or unset) -> logs the message; refused in production.
# ---------------------------------------------------------------------------
SMS_PROVIDER=http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
OTP_HMAC_KEY=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL_USER=
SMTP_EMAIL_PASS=
EMAIL_ALLOW_INSECURE=false
