
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SuperAdmin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
}

model Hospital {
  id              Int               @id @default(autoincrement())
  name            String
  description     String
  city            String
  imageUrl        String?
  contactEmail    String            @unique
  contactPhone    String
  password        String
  status          String            @default("active") // active, inactive
  startTime       String
  endTime         String
  bookingWindow   Int
  accountNumber   String
  doctors         DoctorsOnHospitals[]
  appointments    Appointment[]
  doctorSchedules DoctorSchedule[]
}

model Doctor {
  id              Int                @id @default(autoincrement())
  name            String
  contact         String             @unique
  password        String
  specialty       String
  imageUrl        String?
  bio             String
  consultationFee Int
  rating          Float
  experience      Int?
  status          String             @default("active") // active, inactive
  hospitals       DoctorsOnHospitals[]
  appointments    Appointment[]
  schedules       DoctorSchedule[]
}

model DoctorsOnHospitals {
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId   Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalId Int

  @@id([doctorId, hospitalId])
}

model Patient {
  id           Int           @id @default(autoincrement())
  phone        String        @unique
  name         String
  email        String?       @unique
  age          Int?
  gender       String?
  appointments Appointment[]
}

model Appointment {
  id              String    @id @default(cuid())
  symptoms        String
  patientId       Int
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        Int
  doctor          Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId      Int
  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointmentSlot String
  appointmentDate DateTime
  status          String    @default("confirmed") // confirmed, cancelled, completed, rescheduled
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DoctorSchedule {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId   Int
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  dayOfWeek    String
  workingHours Json
  breakHours   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([doctorId, hospitalId, dayOfWeek])
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
