// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums based on the type definitions in the application

enum Role {
  patient
  doctor
  hospital_admin
  super_admin
}

enum Status {
  active
  inactive
}

enum Gender {
  male
  female
}

enum AppointmentStatus {
  confirmed
  cancelled
  completed
  rescheduled
}

// Models based on the type definitions

model User {
  id       String @id @default(cuid())
  fullName String
  email    String @unique
  phone    String
  role     Role

  // Assuming a user can be a doctor
  doctor Doctor?

  // Assuming a user can make appointments
  appointmentsBooked Appointment[] @relation("BookedByUser")

  // Assuming a user can BE the patient for an appointment
  appointmentsAsPatient Appointment[] @relation("PatientUser")
}

model Hospital {
  id            Int     @id @default(autoincrement())
  name          String
  city          String
  imageId       String
  description   String
  contactEmail  String
  contactPhone  String
  accountNumber String
  status        Status  @default(active)
  doctors       Doctor[]
  appointments  Appointment[]
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           String
  specialty      String
  imageId        String
  bio            String
  consultationFee Float
  rating         Float
  experience     Int?
  contact        String?
  status         Status?  @default(active)

  // Many-to-Many relationship with Hospital
  hospitals      Hospital[] @relation(fields: [hospitalIds], references: [id])
  hospitalIds    Int[]

  appointments   Appointment[]

  // One-to-one relationship with User, if a doctor is also a user
  user    User?   @relation(fields: [userId], references: [id])
  userId  String? @unique
}

model Appointment {
  id              String            @id @default(cuid())
  patientName     String
  patientPhone    String
  patientGender   Gender
  patientAge      Int
  symptoms        String
  appointmentSlot String
  appointmentDate DateTime          @db.Date
  status          AppointmentStatus @default(confirmed)
  relationship    String?

  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId Int

  doctor     Doctor @relation(fields: [doctorId], references: [id])
  doctorId   Int

  // If the person booking is always a registered user
  bookedByUser User?   @relation("BookedByUser", fields: [bookedById], references: [id])
  bookedById   String?

  // If the patient is also a registered user
  patientUser User?   @relation("PatientUser", fields: [patientId], references: [id])
  patientId   String?
}
