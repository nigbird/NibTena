// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER ROLES

model SuperAdmin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
}

model Hospital {
  id                  Int               @id @default(autoincrement())
  name                String
  description         String            @db.Text
  city                String
  imageUrl            String?
  contactEmail        String            @unique
  contactPhone        String
  password            String
  status              String            @default("active") // "active", "inactive"
  startTime           String
  endTime             String
  bookingWindow       Int
  accountNumber       String
  doctors             DoctorsOnHospitals[]
  appointments        Appointment[]
  doctorSchedules     DoctorSchedule[]
}

model Doctor {
  id              Int               @id @default(autoincrement())
  name            String
  contact         String            @unique
  password        String
  specialty       String
  imageUrl        String?
  bio             String            @db.Text
  consultationFee Int
  rating          Float
  experience      Int?
  status          String            @default("active") // "active", "inactive"
  hospitals       DoctorsOnHospitals[]
  appointments    Appointment[]
  schedules       DoctorSchedule[]
}

model Patient {
  id           Int           @id @default(autoincrement())
  phone        String        @unique
  name         String
  email        String?
  age          Int?
  gender       String? // "male", "female"
  appointments Appointment[]
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// JOIN TABLE for Many-to-Many between Doctor and Hospital
model DoctorsOnHospitals {
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId   Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalId Int

  @@id([doctorId, hospitalId])
}


// APPOINTMENTS AND SCHEDULES

enum AppointmentStatus {
  confirmed
  cancelled
  completed
  rescheduled
}

model Appointment {
  id              String            @id @default(cuid())
  patient         Patient           @relation(fields: [patientId], references: [id])
  patientId       Int
  symptoms        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  doctorId        Int
  hospital        Hospital          @relation(fields: [hospitalId], references: [id])
  hospitalId      Int
  appointmentSlot String
  appointmentDate DateTime
  status          AppointmentStatus @default(confirmed)
  createdAt       DateTime          @default(now())
}

model DoctorSchedule {
  id           Int      @id @default(autoinracrement())
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId     Int
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalId   Int
  dayOfWeek    String // e.g., "Monday", "Tuesday"
  workingHours Json
  breakHours   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([doctorId, hospitalId, dayOfWeek])
}