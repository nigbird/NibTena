
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---
enum UserRole {
  superadmin
  hospital
  doctor
  patient
}

enum AppointmentStatus {
  confirmed
  cancelled
  completed
  rescheduled
}

enum DoctorStatus {
  active
  inactive
}

enum HospitalStatus {
  active
  inactive
}

// --- MODELS ---

model SuperAdmin {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  name     String
  password String
  role     UserRole @default(superadmin)
}

model Hospital {
  id              Int           @id @default(autoincrement())
  name            String
  description     String        @db.Text
  city            String
  imageUrl        String?
  contactEmail    String        @unique
  contactPhone    String
  password        String
  status          HospitalStatus @default(active)
  startTime       String        // e.g., "08:00"
  endTime         String        // e.g., "19:00"
  bookingWindow   Int           @default(30) // Days in advance
  accountNumber   String        @unique
  doctors         DoctorsOnHospitals[]
  appointments    Appointment[]
  doctorSchedules DoctorSchedule[]
}

model Doctor {
  id              Int           @id @default(autoincrement())
  name            String
  specialty       String
  imageUrl        String?
  bio             String        @db.Text
  consultationFee Int
  rating          Float
  experience      Int?
  contact         String        @unique
  password        String
  status          DoctorStatus  @default(active)
  hospitals       DoctorsOnHospitals[]
  appointments    Appointment[]
  doctorSchedules DoctorSchedule[]
}

model Patient {
  id           Int           @id @default(autoincrement())
  phone        String        @unique
  name         String
  email        String?
  age          Int?
  gender       String? // "male" or "female"
  appointments Appointment[]
}

model Appointment {
  id              String            @id @default(cuid())
  symptoms        String            @dbText
  appointmentSlot String
  appointmentDate DateTime
  status          AppointmentStatus @default(confirmed)
  createdAt       DateTime          @default(now())
  
  patient         Patient           @relation(fields: [patientId], references: [id])
  patientId       Int
  
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  doctorId        Int
  
  hospital        Hospital          @relation(fields: [hospitalId], references: [id])
  hospitalId      Int
}

model DoctorsOnHospitals {
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  doctorId   Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId Int

  @@id([doctorId, hospitalId])
}

model DoctorSchedule {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  hospitalId   Int
  dayOfWeek    String   // e.g., "Monday"
  workingHours Json     // [{ startTime: "09:00", endTime: "12:00" }]
  breakHours   Json     // [{ startTime: "12:00", endTime: "13:00" }]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([doctorId, hospitalId, dayOfWeek])
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
