datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hospital {
 id                Int                  @id @default(autoincrement())
  name              String               @unique
  description       String
  city              String
  useGlobalEmailId Int?
  useGlobalEmail   EmailSettings?    @relation("HospitalUsesGlobalEmail", fields: [useGlobalEmailId], references: [id])
  // If this hospital has its own custom email settings (one-to-one)
  // one-to-one relation to EmailSettings where EmailSettings.hospitalId holds the FK
  customEmail      EmailSettings?  @relation("HospitalCustomEmail")
  dataRetentionDays Int                  @default(90)
  imageUrl          String?
  contactEmail      String               @unique
  contactPhone      String
  password          String
  mustChangePassword Boolean            @default(false)
  status            String               @default("active") // active, inactive
  startTime         String               @default("08:00")
  endTime           String               @default("19:00")
  bookingWindow     Int                  @default(30)
  accountNumber     String               @unique
  doctors           DoctorsOnHospitals[]
  specialties       Specialty[]
  appointments      Appointment[]
  doctorSchedules   DoctorSchedule[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  User              User[]
  Role              Role[]
}
model EmailSettings {
  id             Int      @id @default(autoincrement())
  name           String?
  smtpHost       String
  smtpPort       Int
  smtpUser       String
  smtpPass       String
  smtpEncryption String   @default("tls")
  imapHost       String?
  imapPort       Int?
  imapUser       String?
  imapPass       String?
  imapEncryption String?
  configured     Boolean  @default(false)
  isGlobal       Boolean  @default(false)
  // If this is a hospital-specific setting, link it here (one-to-one)
  hospitalId     Int?     @unique
  hospital       Hospital? @relation("HospitalCustomEmail", fields: [hospitalId], references: [id])
  // Back-reference: which hospitals chose this global email (one-to-many)
  hospitals      Hospital[] @relation("HospitalUsesGlobalEmail")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Doctor {
  id              Int                  @id @default(autoincrement())
  name            String
  contact         String               @unique
  password        String
  mustChangePassword Boolean            @default(false)
  specialty       String
  imageUrl        String?
  bio             String
  consultationFee Float
  rating          Float
  experience      Int?
  status          String               @default("active") // active, inactive
  hospitals       DoctorsOnHospitals[]
  appointments    Appointment[]
  schedules       DoctorSchedule[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Specialty {
  id         Int      @id @default(autoincrement())
  name       String
  active     Boolean  @default(true)
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hospitalId, name])
}

model DoctorsOnHospitals {
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  doctorId   Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId Int
  assignedAt DateTime @default(now())
  assignedBy String   @default("SuperAdmin")

  @@id([doctorId, hospitalId])
}

model Patient {
  id           Int           @id @default(autoincrement())
  phone        String        @unique
  name         String
  email        String?
  age          Int?
  gender       String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id              String   @id @default(cuid())
  symptoms        String
  patient         Patient  @relation(fields: [patientId], references: [id])
  patientId       Int
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  doctorId        Int
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId      Int
  appointmentSlot String
  appointmentDate DateTime
  status          String   @default("confirmed") // confirmed, cancelled, completed, rescheduled, pending-payment, paid
  transactionId   String?  @unique // ✅ Added: links to payment gateway transaction
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DoctorSchedule {
  id              Int      @id @default(autoincrement())
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  doctorId        Int
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId      Int
  dayOfWeek       String
  workingHours    Json
  breakHours      Json
  patientsPerHour Int      @default(2) // Number of patients doctor can see per hour
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([doctorId, hospitalId, dayOfWeek])
}

// Role & Permission models for dynamic role management
model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String
  phone      String?
  password   String
  mustChangePassword Boolean  @default(false)
  // Optional relation to a role; staff users belong to a hospital
  role       Role?     @relation(fields: [roleId], references: [id])
  roleId     Int?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  hospitalId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String
  isAdmin     Boolean          @default(false)
  hospital    Hospital         @relation(fields: [hospitalId], references: [id])
  hospitalId  Int
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([hospitalId, name])
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique // machine-friendly key e.g. DOCTOR_MANAGE
  name        String // human friendly
  category    String?
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int
  // whether this role has this permission enabled
  allowed      Boolean    @default(true)

  @@id([roleId, permissionId])
}

// Rate limiting store to track failed attempts per identifier (email) and per IP
model RateLimit {
  id            Int       @id @default(autoincrement())
  key           String    @unique // e.g. "email:role:someone@example.com" or "ip:1.2.3.4"
  type          String    // 'email' | 'ip'
  attempts      Int       @default(0)
  firstAttemptAt DateTime?
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
