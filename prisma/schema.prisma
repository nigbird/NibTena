
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Hospital {
  id            Int      @id @default(autoincrement())
  name          String
  city          String
  imageId       String
  description   String
  contactEmail  String
  contactPhone  String
  accountNumber String
  status        String   @default("active") // active, inactive
  doctors       DoctorsOnHospitals[]
  appointments  Appointment[]
  schedules     DoctorSchedule[]
  bookingWindow Int      @default(30)
  startTime     String   @default("08:00")
  endTime       String   @default("18:00")
}

model Doctor {
  id              Int                  @id @default(autoincrement())
  name            String
  specialty       String
  imageId         String
  bio             String
  consultationFee Float
  rating          Float
  experience      Int
  status          String               @default("active") // active, inactive
  hospitals       DoctorsOnHospitals[]
  appointments    Appointment[]
  schedules       DoctorSchedule[]
}

model DoctorsOnHospitals {
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  doctorId   Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId Int

  @@id([doctorId, hospitalId])
}

model Appointment {
  id              String   @id @default(cuid())
  patientName     String
  patientPhone    String
  patientAge      Int
  patientGender   String
  symptoms        String
  doctorId        Int
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId      Int
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  appointmentSlot String
  appointmentDate DateTime
  status          String   @default("confirmed") // confirmed, completed, cancelled, rescheduled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DoctorSchedule {
  id           Int      @id @default(autoincrement())
  doctorId     Int
  doctor       Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId   Int
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  dayOfWeek    String // e.g., "Monday", "Tuesday"
  workingHours Json     // Array of { startTime: "HH:mm", endTime: "HH:mm" }
  breakHours   Json     // Array of { startTime: "HH:mm", endTime: "HH:mm" }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([doctorId, hospitalId, dayOfWeek])
}
